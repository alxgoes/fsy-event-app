// Configuração pública compartilhada pelo app e pela extensão de widgets.
// Valores do seu ambiente ficam em Config/Local.xcconfig (copie Local.example.xcconfig).
// Em .xcconfig, "//" inicia comentário: por isso URLs são informadas só pelo host.

SUPABASE_HOST = vhbmnnpgftrrovjtvbzo.supabase.co
SUPABASE_PUBLISHABLE_KEY =
PORTAL_HOST = fsy-event-app.vercel.app

FSY_BUNDLE_ID = br.com.fsyrp2.app
FSY_DEVELOPMENT_TEAM =
FSY_APP_GROUP =
FSY_APP_ENTITLEMENTS =
FSY_WIDGET_ENTITLEMENTS =
FSY_MARKETING_VERSION = 0.1.0
FSY_BUILD_NUMBER = 1

#include? "Local.xcconfig"

SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 5.0
SWIFT_EMIT_LOC_STRINGS = NO
DEVELOPMENT_TEAM = $(FSY_DEVELOPMENT_TEAM)
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = $(FSY_MARKETING_VERSION)
CURRENT_PROJECT_VERSION = $(FSY_BUILD_NUMBER)
GENERATE_INFOPLIST_FILE = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
ASSETCATALOG_COMPILER_GENERATE_SWIFT_ASSET_SYMBOL_EXTENSIONS = NO
CLANG_ENABLE_MODULES = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = NO
